# https://my.telegram.org से API_ID और API_HASH लें
API_ID=123456
API_HASH=your_api_hash_here

# @BotFather से मिला token
BOT_TOKEN=your_bot_token_here

# अपनी Telegram numeric user ID
OWNER_ID=123456789

# सिर्फ reference के लिए (ज़रूरी नहीं)
PRIVATE_CHANNEL_ID=-1001234567890

# डेटा फ़ाइल (वैकल्पिक)
DATA_FILE=fsub_data.json

# ✨ Branding (UI look)
BRAND_NAME=AUTO APPROVE
BRAND_LINK=            # optional, जैसे https://t.me/yourchannel — footer में link बन जाएगा
DEV_TAG=               # optional, जैसे @yourchannel

# 📡 Keep-alive server (Render के लिए)
PORT=3000              # Render PORT अपने-आप set करता है — local में 3000
SELF_PING_URL=         # optional, जैसे https://your-app.onrender.com/ping

# ⚡ Message reactions (on/off) — chat में reactions enabled हों तो काम करेगा
REACTIONS=on
