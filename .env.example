# Telegram bot token from @BotFather
BOT_TOKEN=your_bot_token_here

# Your numeric Telegram user ID
OWNER_ID=123456789

# Branding (UI)
BRAND_NAME=AUTO APPROVAL BOT
BRAND_LINK=            # optional, e.g. https://t.me/yourchannel
DEV_TAG=               # optional, e.g. @yourchannel

# Super reactions on user messages & the bot's own replies (on/off)
REACTIONS=on

# Animated message effects on bot messages (private chats only) (on/off)
EFFECTS=on
# Telegram effect ID used for the celebration moment (🎉).
# Default is the celebration effect; override with any effect ID you want.
DEFAULT_CELEBRATION_EFFECT_ID=5046509860389126442

# Welcome Theme music (on/off). Served from /welcome.mp3 and sent with /start
WELCOME_AUDIO=on
# Public base URL of this deployment (used as the rich-message <audio> src)
PUBLIC_URL=https://auto-approve-bot-m60r.onrender.com
# Optional: use your own audio URL instead of the bundled welcome.mp3
WELCOME_AUDIO_URL=

# Keep-alive server (Render sets PORT automatically)
PORT=3000
SELF_PING_URL=         # optional, e.g. https://your-app.onrender.com/ping

# Data file (optional)
DATA_FILE=fsub_data.json
